{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseCut",
  "version": "0.1.0",
  "identifier": "com.zeropulse.pulsecut",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": ".."
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": ".."
    },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PulseCut",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "backgroundColor": "#0c0d10"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$CACHE/**", "$TEMP/**", "/tmp/**"],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
