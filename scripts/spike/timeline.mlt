<?xml version="1.0" encoding="utf-8"?>
<!-- Spike timeline: V1 = clip_a[1s..3s) then clip_b[0..2s); V2 = clip_b PiP 50% at t=1..2s; A1 = music bed 0..4s -->
<mlt LC_NUMERIC="C" version="7.22.0" producer="main_bin">
  <profile description="640x360 30fps" width="640" height="360" progressive="1" sample_aspect_num="1" sample_aspect_den="1" display_aspect_num="16" display_aspect_den="9" frame_rate_num="30" frame_rate_den="1" colorspace="709"/>
  <producer id="a"><property name="resource">/workspace/fixtures/media/clip_a_640x360_30fps.mp4</property></producer>
  <producer id="b"><property name="resource">/workspace/fixtures/media/clip_b_640x360_25fps.mov</property></producer>
  <producer id="b2"><property name="resource">/workspace/fixtures/media/clip_b_640x360_25fps.mov</property></producer>
  <producer id="m"><property name="resource">/workspace/fixtures/media/music_bed_48k.wav</property></producer>
  <playlist id="v1">
    <entry producer="a" in="30" out="89"/>
    <entry producer="b" in="0" out="59"/>
  </playlist>
  <playlist id="v2">
    <blank length="30"/>
    <entry producer="b2" in="0" out="29"/>
  </playlist>
  <playlist id="a1"><entry producer="m" in="0" out="119"/></playlist>
  <tractor id="t" in="0" out="119">
    <multitrack><track producer="v1"/><track producer="v2"/><track producer="a1" hide="video"/></multitrack>
    <transition mlt_service="affine" a_track="0" b_track="1"><property name="rect">0 0 320 180 1</property><property name="fill">1</property></transition>
    <transition mlt_service="mix" a_track="0" b_track="1"><property name="sum">1</property><property name="always_active">1</property></transition>
    <transition mlt_service="mix" a_track="0" b_track="2"><property name="sum">1</property><property name="always_active">1</property></transition>
  </tractor>
</mlt>
